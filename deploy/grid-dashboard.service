[Unit]
Description=GRID Dashboard (Streamlit)
After=network.target grid-api.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/GRID
Environment=GRID_API=http://127.0.0.1:8000
ExecStart=/home/ubuntu/GRID/.venv/bin/streamlit run dashboard/app.py --server.port 8501 --server.address 127.0.0.1 --server.headless true --server.baseUrlPath dashboard
Restart=always

[Install]
WantedBy=multi-user.target
